{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Strictness (Phase 1 requirement) */
    "strict": true,
    "noUncheckedIndexedAccess": true,

    /* Path aliases. `baseUrl` is deprecated as of TS 5.9 (removed in TS 7,
       see https://aka.ms/ts6) — dropped here rather than silenced, since
       `paths` alone already resolves relative to this config file's own
       directory (identical to `baseUrl: "."`), so behavior is unchanged.
       Vite's own bundling doesn't consult this at all — `vite.config.ts`
       defines the `@` alias independently via `resolve.alias`. */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
